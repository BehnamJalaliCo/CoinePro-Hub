{
  "id": "hqFlowsClock0001",
  "name": "hq-flows",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Tehran",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "meta": {
    "note": "contract §59.7, §59.9 (prompt 38): the flows' clock. Each minute a signed tick (the hub starts every flow whose occurrence is due); at 21:30 Tehran the owner's day (one notification). No model key, no model call."
  },
  "pinData": {},
  "nodes": [
    {
      "id": "9c1a0000-0000-4000-8000-000000000001",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "* * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "9c1a0000-0000-4000-8000-000000000002",
      "name": "Tick, signed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.HQ_SIGNING_SECRET || '';\nif (!secret) throw new Error('no signing secret');\n// the hub reads no field of it: the signed minute is the tick\nconst body = JSON.stringify({ at: new Date().toISOString() });\nconst ts = Math.floor(Date.now() / 1000);\nconst mac = crypto.createHmac('sha256', secret).update(`${ts}.`).update(body).digest('hex');\nreturn [{ json: { body, signature: `t=${ts},v1=${mac}` } }];"
      }
    },
    {
      "id": "9c1a0000-0000-4000-8000-000000000003",
      "name": "Tick the hub",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/internal/v1/flows/tick",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HQ-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "9c1a0000-0000-4000-8000-000000000004",
      "name": "Every day 21:30 Tehran",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        240
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 21 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "9c1a0000-0000-4000-8000-000000000005",
      "name": "The day, signed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        240
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.HQ_SIGNING_SECRET || '';\nif (!secret) throw new Error('no signing secret');\n// today in Tehran: the owner's day the summary is of\nconst day = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tehran', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());\nconst body = JSON.stringify({ day });\nconst ts = Math.floor(Date.now() / 1000);\nconst mac = crypto.createHmac('sha256', secret).update(`${ts}.`).update(body).digest('hex');\n// the hub's Idempotency-Key is a UUID: one made from the day (the same on a retry)\nconst h = crypto.createHash('sha256').update(`flows:summary:${day}`).digest('hex');\nconst key = `${h.slice(0, 8)}-${h.slice(8, 12)}-5${h.slice(13, 16)}-${((parseInt(h[16], 16) & 3) | 8).toString(16)}${h.slice(17, 20)}-${h.slice(20, 32)}`;\nreturn [{ json: { body, signature: `t=${ts},v1=${mac}`, key } }];"
      }
    },
    {
      "id": "9c1a0000-0000-4000-8000-000000000006",
      "name": "The owner's day",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/internal/v1/flows/summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-HQ-Signature",
              "value": "={{ $json.signature }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.key }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Tick, signed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Tick, signed": {
      "main": [
        [
          {
            "node": "Tick the hub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Every day 21:30 Tehran": {
      "main": [
        [
          {
            "node": "The day, signed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "The day, signed": {
      "main": [
        [
          {
            "node": "The owner's day",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
