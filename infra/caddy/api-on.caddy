# With a domain over HTTPS (HQ_API_EDGE=on, set by infra/compose/hq.sh).
# Imported inside the site block, so the first header applies to the whole site.

# HSTS for the whole site (HTTPS only, hence only in this snippet).
header Strict-Transport-Security "max-age=31536000; includeSubDomains"

# The API's own policy (the web pages set their CSP themselves).
@api path /api/*
header @api {
	Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
}

# The live streams (SSE: /api/v1/stream and /api/v1/threads/<code>/live):
# flushed at once and never timed out by the proxy.
@sse path /api/v1/stream /api/v1/threads/*/live /api/v1/workshop/sessions/*/live
handle @sse {
	reverse_proxy api:8000 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 0
		}
	}
}

# Owner uploads and media (prompt 6 §2): a video may be 200 MB (the api checks
# type, size and duration while it streams in); downloads stream with Range.
@media path /api/v1/files /api/v1/files/* /api/v1/transcribe
handle @media {
	request_body {
		max_size 201MB
	}
	reverse_proxy api:8000 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}
}

# Intake from outside (prompt 10 §9): the only public routes prompt 10 adds,
# exactly three, each with a 1 MB body. Telegram's webhook only from
# Telegram's published ranges (core.telegram.org/bots/webhooks); the api checks
# the secret token, the HMAC, the timestamp, the event ids and each source's
# own IP list, and counts calls per source (the stock Caddy image has no rate
# limiter). Anything else under /intake is an unknown path.
@intake_telegram path /intake/v1/telegram/*
handle @intake_telegram {
	@not_telegram not remote_ip 149.154.160.0/20 91.108.4.0/22
	respond @not_telegram 403
	request_body {
		max_size 1MB
	}
	reverse_proxy api:8000 {
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 30s
		}
	}
}

@intake_signed path /intake/v1/chatwoot/* /intake/v1/product/*
handle @intake_signed {
	request_body {
		max_size 1MB
	}
	reverse_proxy api:8000 {
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 30s
		}
	}
}

handle /intake/* {
	respond 404
}

# Everything else under /api: bodies capped and a normal read timeout.
handle /api/* {
	request_body {
		max_size 2MB
	}
	reverse_proxy api:8000 {
		header_up X-Forwarded-For {remote_host}
		transport http {
			read_timeout 60s
		}
	}
}
