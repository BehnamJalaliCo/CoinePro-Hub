# Profile "full": servers with a nominal 12 GB of RAM or more.
# Adds Tempo, otel-collector and cAdvisor.
# Rule: the sum of every container's memory limit stays <= 60% of RAM
# (enforced by scripts/quality/memory-budget.sh). Budget reference = the
# smallest server that selects this profile (MemTotal 11 GiB).
HQ_BUDGET_REF_RAM_MB=11264

# Memory limits (Compose units)
MEM_POSTGRES=1536m
MEM_VALKEY=512m
MEM_NATS=384m
MEM_TEMPORAL=832m
MEM_TEMPORAL_UI=128m
MEM_OPENBAO=192m
MEM_CADDY=128m
MEM_PROMETHEUS=640m
MEM_GRAFANA=448m
MEM_LOKI=448m
MEM_NODE_EXPORTER=64m
MEM_ALLOY=224m
MEM_TEMPO=512m
MEM_OTEL_COLLECTOR=256m
MEM_CADVISOR=192m
# One-shot jobs (exit after running)
MEM_HQ_TOOLS=16m
MEM_TEMPORAL_SCHEMA=128m
MEM_TEMPORAL_NAMESPACE=64m

# Go runtime soft limits (~80% of the container limit)
GOMEMLIMIT_NATS=300MiB
GOMEMLIMIT_TEMPORAL=660MiB
GOMEMLIMIT_LOKI=350MiB
GOMEMLIMIT_ALLOY=180MiB

# PostgreSQL
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=384MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAINTENANCE_WORK_MEM=96MB
PG_WORK_MEM=8MB

# Valkey (cache; must sit below MEM_VALKEY)
VALKEY_MAXMEMORY=384mb

# Retention
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=8GB
LOKI_RETENTION_PERIOD=720h
