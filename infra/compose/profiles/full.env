# Profile "full": servers with a nominal 12 GB of RAM or more.
# Adds Tempo, otel-collector and cAdvisor.
# Rule: the sum of every container's memory limit stays <= 80% of RAM
# (prompt 03; it was 60% for the platform alone in prompt 02)
# (enforced by scripts/quality/memory-budget.sh). Budget reference = the
# smallest server that selects this profile (MemTotal 11 GiB).
HQ_BUDGET_REF_RAM_MB=11264

# Memory limits (Compose units)
MEM_POSTGRES=1536m
MEM_VALKEY=256m
MEM_NATS=256m
MEM_TEMPORAL=832m
MEM_TEMPORAL_UI=128m
MEM_OPENBAO=192m
MEM_CADDY=128m
MEM_PROMETHEUS=512m
MEM_GRAFANA=448m
MEM_LOKI=320m
MEM_NODE_EXPORTER=64m
MEM_ALLOY=224m
MEM_TEMPO=384m
MEM_OTEL_COLLECTOR=256m
MEM_CADVISOR=192m
# LLM layer (prompt 03). claude-runtime: ~180 MB per idle CLI process,
# ~250-300 MB while answering, x RUNTIME_MAX_CONCURRENCY, + the service.
MEM_LLM_ROUTER=320m
MEM_CLAUDE_RUNTIME=1600m
LLM_MAX_CONCURRENCY=5
RUNTIME_MAX_CONCURRENCY=5
# One-shot jobs (exit after running)
MEM_DB_PROVISION=64m
MEM_LLM_MIGRATE=192m
MEM_HQ_TOOLS=16m
MEM_TEMPORAL_SCHEMA=128m
MEM_TEMPORAL_NAMESPACE=64m

# Go runtime soft limits (~80% of the container limit)
GOMEMLIMIT_NATS=200MiB
GOMEMLIMIT_TEMPORAL=660MiB
GOMEMLIMIT_LOKI=250MiB
GOMEMLIMIT_ALLOY=180MiB

# PostgreSQL
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=384MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAINTENANCE_WORK_MEM=96MB
PG_WORK_MEM=8MB

# Valkey (cache; must sit below MEM_VALKEY)
VALKEY_MAXMEMORY=192mb

# Retention
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=8GB
LOKI_RETENTION_PERIOD=720h

# Holding core (prompt 04); cache, NATS, Prometheus, Loki and Tempo trimmed
# to stay inside the 80% rule (same measurements as the lean profile).
MEM_API=320m
MEM_WORKER=288m
MEM_OPA=96m
MEM_API_MIGRATE=160m
