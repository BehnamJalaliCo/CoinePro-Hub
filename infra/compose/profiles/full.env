# Profile "full": the hub's own class of server, 16 GB (MemTotal >= 15 GiB;
# prompt 05 §11). Adds Tempo and otel-collector. cAdvisor is NOT part of it
# any more: it needs the Docker socket (root on the host); container metrics
# come socket-free from infra/observability/container-metrics.sh. It is still
# available on its own opt-in profile "cadvisor".
# Rule: the sum of every container's memory limit stays <= 80% of RAM, with
# at least 5% of that budget left over and room for every opt-in profile
# (enforced by scripts/quality/memory-budget.sh). Budget reference = the
# smallest server this profile is picked for: the 15 GiB threshold of
# infra/compose/hq.sh (prompt 05.1 §3), not the hub's own MemTotal.
HQ_BUDGET_REF_RAM_MB=15360

# Memory limits (Compose units). Measured idle use (docker stats, lean,
# 2026-10-17) in brackets; limits leave room for load and for 30 days of
# retention in Prometheus and Loki.
# Prompt 07 §2.9: room for egress, SearXNG and the browser. Five limits come down
# to ~2-3x their live use (docker stats on this hub, 2026-10-17: in <>), the room
# prompt 6 had named for STT (RUNBOOK §16 option 2): before -> after.
MEM_POSTGRES=1024m        # [204 MiB] <182 MiB> 1536m -> 1024m; shared_buffers 384MB stays
MEM_VALKEY=256m           # [13 MiB]  cache, maxmemory below
MEM_NATS=192m             # [24 MiB] <8 MiB> 256m -> 192m
MEM_TEMPORAL=768m         # [271 MiB] <339 MiB>; 832m -> 768m (prompt 07 merge)
MEM_TEMPORAL_UI=128m      # [29 MiB]
MEM_OPENBAO=320m           # [153 MiB measured] x 2 = 306: 256m -> 320m (the 2x rule, review 7.1 §0.2, 2026-10-22)
MEM_CADDY=128m            # [60 MiB]
MEM_PROMETHEUS=512m       # [213 MiB] <178 MiB> 768m -> 512m; 30 d retention
MEM_GRAFANA=576m           # [275 MiB measured] x 2 = 550: 512m -> 576m (the 2x rule, review 7.1 §0.2, 2026-10-22)
MEM_LOKI=384m             # [177 MiB] <77 MiB> 512m -> 384m; 30 d retention
MEM_NODE_EXPORTER=64m     # [27 MiB]
MEM_ALLOY=384m             # [180 MiB measured] x 2 = 360: 256m -> 384m (the 2x rule, review 7.1 §0.2, 2026-10-22)
MEM_TEMPO=256m            # <115 MiB> 384m -> 256m
MEM_OTEL_COLLECTOR=512m    # opt-in profile "tracing" now; [231 MiB measured] x 2 = 462 (review 7.1 §0.2, 2026-10-22)
MEM_CADVISOR=192m         # opt-in profile "cadvisor" only
# Speech to text, opt-in profile "stt" (prompt 06 §3; measured 2026-10-17 on
# this CPX42, large-v3-turbo int8, beam 5, 4 threads): 961 MiB loaded,
# 1644 MiB peak while loading (fp16 -> int8), 1301 MiB transcribing 30 s,
# 1460 MiB transcribing 5 min; 177 MiB after the idle unload. Peak + 25%.
MEM_STT=2048m
MEM_STT_FETCH=128m        # the one-shot model download (streamed, hashed)
# LLM layer (prompt 03). claude-runtime: ~180 MB per idle CLI process,
# ~250-300 MB while answering, x RUNTIME_MAX_CONCURRENCY, + the service.
MEM_LLM_ROUTER=384m       # [52 MiB] + the Quota Controller
MEM_CLAUDE_RUNTIME=1856m   # [93 MiB idle] 4 concurrent CLI runs (~460 MiB each with headroom); 2304m -> 1856m (review 7.1 §0.2, 2026-10-22)
LLM_MAX_CONCURRENCY=4      # follows the runtime: 5 -> 4 (review 7.1 §0.2, 2026-10-22)
RUNTIME_MAX_CONCURRENCY=4  # 5 -> 4 (review 7.1 §0.2, 2026-10-22)
# One-shot jobs (exit after running)
MEM_DB_PROVISION=64m
MEM_LLM_MIGRATE=192m
MEM_HQ_TOOLS=16m
# The hourly backup job (restic + its rclone backend, prompt 07 §1), one at a time.
MEM_BACKUP=256m           # restic + rclone one-shot; 400 MB snapshot ran under 192m; 384m -> 256m (prompt 07 merge)
MEM_TEMPORAL_SCHEMA=128m
MEM_TEMPORAL_NAMESPACE=64m

# Go runtime soft limits (~80% of the container limit)
GOMEMLIMIT_NATS=150MiB
GOMEMLIMIT_TEMPORAL=610MiB # ~80% of MEM_TEMPORAL
GOMEMLIMIT_LOKI=300MiB
GOMEMLIMIT_ALLOY=300MiB    # ~80% of MEM_ALLOY

# PostgreSQL
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=384MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAINTENANCE_WORK_MEM=96MB
PG_WORK_MEM=8MB

# Valkey (cache; must sit below MEM_VALKEY)
VALKEY_MAXMEMORY=192mb

# Retention
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=8GB
LOKI_RETENTION_PERIOD=720h

# Holding core (prompt 04)
MEM_API=384m              # [105 MiB] + live replies (SSE)
MEM_WORKER=512m           # [98 MiB] + agent runs (conversations in memory)
MEM_OPA=128m              # [49 MiB]
MEM_API_MIGRATE=192m
# Agents at work (prompt 05)
MEM_GATEWAY=128m
MEM_WEB=320m              # <53 MiB> + tmpfs (64m + 64m) inside; 384m -> 320m (prompt 07 merge)
# The agents' internet (prompt 07 §2; measured 2026-10-17 in throwaway containers:
# idle / peak with real searches, reads and two parallel browse sessions).
# The provisioner (prompt 09 §4), opt-in profile "provisioning": 43 MiB idle
# (measured 2026-10-18), a run adds a few MiB (hcloud calls, the user data).
MEM_PROVISIONER=128m
EGRESS_PARSE_SLOTS=1       # one PDF/HTML parse child at a time (review 7.1 §2.20)
MEM_EGRESS=512m            # one parse child at a time peaks at ~235 MiB x 2 (the 2x rule; review 7.1 §2.20, 2026-10-22)
MEM_SEARXNG=256m          # 110 / 124 MiB
MEM_BROWSER=768m           # ~380 MiB peak with one session x 2 (the 2x rule); 896m -> 768m (review 7.1 §0.2, 2026-10-22)
BROWSER_MAX_SESSIONS=1     # one session in full too (review 7.1 §0.2, 2026-10-22)
BROWSER_TMPFS=192m        # profiles, cache, downloads (inside MEM_BROWSER)
WEB_TMPFS_TMP=64m
WEB_TMPFS_CACHE=64m
# The substitute players (prompt 12 §9.1, contract §21.13), opt-in profiles,
# OFF until the owner signs them in and the budget allows (memory measured
# 2026-10-22 on this CPX42, cgroup memory.peak, offline: no sign-in exists):
# - substitute-runner (profile "substitutes"), one call at a time: the
#   wrapper 21 MiB, Codex CLI 92 MiB, Gemini CLI 299 MiB headless and 314 MiB
#   with its terminal UI (Node + its bundle). ~1.6x the largest.
MEM_SUBSTITUTE=512m
# - browser-web (profile "substitutes-web"): the persistent profile on the
#   fake ChatGPT site peaked at 224 MiB (test process, site and Chromium
#   together); a real chat site is heavier, so the browser's own measured
#   ~380 MiB x 2 (the 2x rule). Downloads on its own tmpfs (inside).
MEM_BROWSER_WEB=768m
BROWSER_WEB_TMPFS=64m
# - the owner's sign-in window (profile "web-login", `make <x>-web-login`
#   only, 15 minutes): a visible Chromium, Xvfb, x11vnc and noVNC; its relay.
MEM_BROWSER_LOGIN=1024m
MEM_WEB_LOGIN_RELAY=32m
