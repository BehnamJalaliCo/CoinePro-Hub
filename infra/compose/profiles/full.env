# Profile "full": the hub's own class of server, 16 GB (MemTotal >= 15 GiB;
# prompt 05 §11). Adds Tempo and otel-collector. cAdvisor is NOT part of it
# any more: it needs the Docker socket (root on the host); container metrics
# come socket-free from infra/observability/container-metrics.sh. It is still
# available on its own opt-in profile "cadvisor".
# Rule: the sum of every container's memory limit stays <= 80% of RAM, with
# at least 5% of that budget left over and room for every opt-in profile
# (enforced by scripts/quality/memory-budget.sh). Budget reference = the
# smallest server this profile is picked for: the 15 GiB threshold of
# infra/compose/hq.sh (prompt 05.1 §3), not the hub's own MemTotal.
HQ_BUDGET_REF_RAM_MB=15360

# Memory limits (Compose units). Measured idle use (docker stats, lean,
# 2026-10-17) in brackets; limits leave room for load and for 30 days of
# retention in Prometheus and Loki.
MEM_POSTGRES=1536m        # [204 MiB]
MEM_VALKEY=256m           # [13 MiB]  cache, maxmemory below
MEM_NATS=256m             # [24 MiB]
MEM_TEMPORAL=832m         # [271 MiB]
MEM_TEMPORAL_UI=128m      # [29 MiB]
MEM_OPENBAO=256m          # [153 MiB] was tight at 192m
MEM_CADDY=128m            # [60 MiB]
MEM_PROMETHEUS=768m       # [213 MiB] 30 d retention
MEM_GRAFANA=512m          # [340 MiB] was tight at 384m
MEM_LOKI=512m             # [177 MiB] 30 d retention
MEM_NODE_EXPORTER=64m     # [27 MiB]
MEM_ALLOY=320m            # [180 MiB] was tight at 192m
MEM_TEMPO=384m
MEM_OTEL_COLLECTOR=384m   # [231 MiB of 256m, 2026-10-17: over its 80% memory_limiter]
MEM_CADVISOR=192m         # opt-in profile "cadvisor" only
# Speech to text, opt-in profile "stt" (prompt 06 §3; measured 2026-10-17 on
# this CPX42, large-v3-turbo int8, beam 5, 4 threads): 961 MiB loaded,
# 1644 MiB peak while loading (fp16 -> int8), 1301 MiB transcribing 30 s,
# 1460 MiB transcribing 5 min; 177 MiB after the idle unload. Peak + 25%.
MEM_STT=2048m
MEM_STT_FETCH=128m        # the one-shot model download (streamed, hashed)
# LLM layer (prompt 03). claude-runtime: ~180 MB per idle CLI process,
# ~250-300 MB while answering, x RUNTIME_MAX_CONCURRENCY, + the service.
MEM_LLM_ROUTER=384m       # [52 MiB] + the Quota Controller
MEM_CLAUDE_RUNTIME=2304m  # [93 MiB idle] 5 concurrent CLI runs (5 x 300 + service + headroom)
LLM_MAX_CONCURRENCY=5
RUNTIME_MAX_CONCURRENCY=5
# One-shot jobs (exit after running)
MEM_DB_PROVISION=64m
MEM_LLM_MIGRATE=192m
MEM_HQ_TOOLS=16m
# The hourly backup job (restic + its rclone backend, prompt 07 §1), one at a time.
MEM_BACKUP=384m
MEM_TEMPORAL_SCHEMA=128m
MEM_TEMPORAL_NAMESPACE=64m

# Go runtime soft limits (~80% of the container limit)
GOMEMLIMIT_NATS=200MiB
GOMEMLIMIT_TEMPORAL=660MiB
GOMEMLIMIT_LOKI=400MiB
GOMEMLIMIT_ALLOY=256MiB

# PostgreSQL
PG_MAX_CONNECTIONS=200
PG_SHARED_BUFFERS=384MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_MAINTENANCE_WORK_MEM=96MB
PG_WORK_MEM=8MB

# Valkey (cache; must sit below MEM_VALKEY)
VALKEY_MAXMEMORY=192mb

# Retention
PROM_RETENTION_TIME=30d
PROM_RETENTION_SIZE=8GB
LOKI_RETENTION_PERIOD=720h

# Holding core (prompt 04)
MEM_API=384m              # [105 MiB] + live replies (SSE)
MEM_WORKER=512m           # [98 MiB] + agent runs (conversations in memory)
MEM_OPA=128m              # [49 MiB]
MEM_API_MIGRATE=192m
# Agents at work (prompt 05)
MEM_GATEWAY=128m
MEM_WEB=384m              # [56 MiB] its tmpfs below count inside this limit
WEB_TMPFS_TMP=64m
WEB_TMPFS_CACHE=64m
