# Profile "lean": servers below 15 GiB of RAM (the fallback if the hub is ever
# scaled down; it ran on 7.6 GiB until prompt 04.2). Tempo and
# otel-collector stay off; cAdvisor is opt-in (profile "cadvisor").
# Rule: the sum of every container's memory limit stays <= 80% of RAM
# (prompt 03; it was 60% for the platform alone in prompt 02), with at least
# 5% of that budget left over and room for every opt-in profile (cAdvisor)
# (enforced by scripts/quality/memory-budget.sh). Budget reference = the
# 8 GB class the hub ran on until prompt 04.2 (its MemTotal then).
HQ_BUDGET_REF_RAM_MB=7745

# Memory limits (Compose units)
# Prompt 07 §2.9: room for egress, SearXNG and the browser (live use on the hub,
# 2026-10-17, in <>): before -> after.
MEM_POSTGRES=640m
MEM_VALKEY=96m
MEM_NATS=64m              # <8 MiB>; 128m -> 64m (prompt 07 merge)
MEM_TEMPORAL=512m
MEM_TEMPORAL_UI=32m
MEM_OPENBAO=192m
MEM_CADDY=48m             # <20 MiB>; 64m -> 48m (prompt 07 merge)
MEM_PROMETHEUS=256m
MEM_GRAFANA=384m
MEM_LOKI=160m             # <77 MiB>; 192m -> 160m (prompt 07 merge)
MEM_NODE_EXPORTER=48m
MEM_ALLOY=192m
MEM_TEMPO=512m
MEM_OTEL_COLLECTOR=256m
MEM_CADVISOR=192m
# Speech to text, opt-in profile "stt": as full (the model does not shrink).
MEM_STT=2048m
MEM_STT_FETCH=128m
# LLM layer (prompt 03). claude-runtime: ~180 MB per idle CLI process,
# ~250-300 MB while answering, x RUNTIME_MAX_CONCURRENCY, + the service.
MEM_LLM_ROUTER=128m       # <54 MiB>; 192m -> 128m (prompt 7.1 §2.20: room for egress)
MEM_CLAUDE_RUNTIME=768m
LLM_MAX_CONCURRENCY=2
RUNTIME_MAX_CONCURRENCY=2
# One-shot jobs (exit after running)
MEM_DB_PROVISION=48m      # one-shot psql; 64m -> 48m (prompt 07 merge)
MEM_LLM_MIGRATE=160m
MEM_HQ_TOOLS=16m
# The hourly backup job (restic + its rclone backend, prompt 07 §1), one at a time.
MEM_BACKUP=192m
MEM_TEMPORAL_SCHEMA=96m   # one-shot schema tool; 128m -> 96m (prompt 07 merge)
MEM_TEMPORAL_NAMESPACE=64m

# Go runtime soft limits (~80% of the container limit)
GOMEMLIMIT_NATS=50MiB     # ~80% of MEM_NATS
GOMEMLIMIT_TEMPORAL=420MiB
GOMEMLIMIT_LOKI=128MiB    # ~80% of MEM_LOKI
GOMEMLIMIT_ALLOY=150MiB

# PostgreSQL
PG_MAX_CONNECTIONS=120
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=640MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_WORK_MEM=4MB

# Valkey (cache; must sit below MEM_VALKEY)
VALKEY_MAXMEMORY=64mb

# Retention
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=4GB
LOKI_RETENTION_PERIOD=336h

# Holding core (prompt 04). To stay inside the 80% rule the cache, NATS,
# Prometheus, Loki, Temporal UI and llm-migrate limits were trimmed to what
# they measurably use plus headroom (docker stats, 2026-10-17: valkey 5 MiB,
# nats 6 MiB, prometheus 101 MiB, loki 68 MiB).
MEM_API=224m
MEM_WORKER=224m           # [98 MiB]; 256m -> 224m (prompt 7.1 §2.20: room for egress)
MEM_OPA=64m
MEM_API_MIGRATE=160m
# Agents at work (prompt 05): the gateway and the web panel; to stay inside the
# 80% rule postgres, temporal and claude-runtime gave back what they measurably
# did not use. Prompt 05.1 §2.10: 5% of the budget stays free and cAdvisor
# fits too, so claude-runtime runs 2 CLI processes (2 x ~300 MiB + the
# service), postgres, Prometheus (101 MiB measured), Loki (68 MiB) and the
# Temporal UI (29 MiB) were trimmed, and the web's tmpfs (counted inside its
# limit) shrank: /tmp 16m + .next/cache 32m of 224m.
MEM_GATEWAY=80m
MEM_WEB=160m              # <53 MiB> + its 48m of tmpfs; 192m -> 160m (prompt 7.1 §2.20)
WEB_TMPFS_TMP=16m
WEB_TMPFS_CACHE=32m

# Prompt 07 §2.9 (lean): the agents' internet with one browser session at a time.
# Changed above for it (live use <>, before -> after): postgres <182> 832m -> 640m
# (shared_buffers 256MB stays), valkey <4> 128m -> 96m (maxmemory 96mb -> 64mb),
# nats <8> 160m -> 128m, temporal <334> 608m -> 512m, caddy <18> 96m -> 64m,
# prometheus <178> 320m -> 256m, loki <77> 224m -> 192m, web <53> 224m -> 192m,
# temporal-ui <7> 48m -> 32m, node-exporter <21> 64m -> 48m, llm-router <54>
# 256m -> 192m, api <117> 256m -> 224m, opa <16> 96m -> 64m, gateway <40> 96m ->
# 80m (and the Go soft limits with them). Tempo and otel are full-only.
# The provisioner (prompt 09 §4), opt-in profile "provisioning": 43 MiB idle
# (measured 2026-10-18), a run adds a few MiB (hcloud calls, the user data).
MEM_PROVISIONER=96m
# Prompt 7.1 §2.20: egress measured for a 20 MB body and its lxml tree (a
# throwaway container of the real service, production's user and read-only
# root, memory.peak of its cgroup = the service and its parse children; one
# child at a time here, EGRESS_PARSE_SLOTS=1): idle 55 MiB; a 20 MB page 149
# (a child parses its first 4 MiB); the PDF bomb 209 (its child stopped at
# 192 MiB); a 20 MB http body 60; a browse with 16 MiB of files 122; two at
# once, the worst pair: bomb + 20 MB page 235, bomb + browse 232. 128m held
# none of these; 256m holds every pair (lean runs 2 agent runs, so 2 calls at
# a time). Beyond (4 heavy calls at once: 258) the kernel kills the parse
# child first (oom_score_adj 1000), never the service. Room: llm-router,
# worker and web above (-128m).
MEM_EGRESS=256m           # 128m -> 256m (prompt 7.1 §2.20, measured above)
EGRESS_PARSE_SLOTS=1
MEM_SEARXNG=160m          # 110 / 124 MiB
MEM_BROWSER=448m          # ~380 MiB with its one session (tmpfs inside); 480m -> 448m (prompt 07 merge)
BROWSER_MAX_SESSIONS=1
BROWSER_TMPFS=128m

# Prompt 12 §14: the MCP servers in containers, opt-in profile "mcp" (measured
# 2026-10-22 on this CPX42 in throwaway containers; memory.peak includes page
# cache): mcp-time 92 MiB idle and after calls, 97 MiB peak (x 2); CodeCortex
# on the hub repository (1324 files, 10047 nodes) 76 MiB idle, 133 MiB after
# calls, 307 MiB peak; its full index job 330 MiB peak (12 s), unchanged 14 MiB.
MEM_MCP_TIME=192m
MEM_MCP_CODECORTEX=384m
MEM_MCP_CODECORTEX_INDEX=448m
# The substitute players (prompt 12 §9.1, contract §21.13), opt-in profiles,
# OFF until the owner signs them in and the budget allows (memory measured
# 2026-10-22 on this CPX42, cgroup memory.peak, offline: no sign-in exists):
# - substitute-runner (profile "substitutes"), one call at a time: the
#   wrapper 21 MiB, Codex CLI 92 MiB, Gemini CLI 299 MiB headless and 314 MiB
#   with its terminal UI (Node + its bundle). ~1.6x the largest.
MEM_SUBSTITUTE=512m
# - browser-web (profile "substitutes-web"): the persistent profile on the
#   fake ChatGPT site peaked at 224 MiB (test process, site and Chromium
#   together); a real chat site is heavier, so the browser's own measured
#   ~380 MiB x 2 (the 2x rule). Downloads on its own tmpfs (inside).
MEM_BROWSER_WEB=448m
BROWSER_WEB_TMPFS=64m
# - the owner's sign-in window (profile "web-login", `make <x>-web-login`
#   only, 15 minutes): a visible Chromium, Xvfb, x11vnc and noVNC; its relay.
MEM_BROWSER_LOGIN=768m
MEM_WEB_LOGIN_RELAY=32m
