# Profile "lean": servers below a nominal 12 GB of RAM (today's hub: 7.6 GiB).
# Tempo, otel-collector and cAdvisor stay off.
# Rule: the sum of every container's memory limit stays <= 80% of RAM
# (prompt 03; it was 60% for the platform alone in prompt 02)
# (enforced by scripts/quality/memory-budget.sh). Budget reference = the
# hub's MemTotal today.
HQ_BUDGET_REF_RAM_MB=7745

# Memory limits (Compose units)
MEM_POSTGRES=1024m
MEM_VALKEY=320m
MEM_NATS=256m
MEM_TEMPORAL=640m
MEM_TEMPORAL_UI=96m
MEM_OPENBAO=192m
MEM_CADDY=96m
MEM_PROMETHEUS=512m
MEM_GRAFANA=384m
MEM_LOKI=384m
MEM_NODE_EXPORTER=64m
MEM_ALLOY=192m
MEM_TEMPO=512m
MEM_OTEL_COLLECTOR=256m
MEM_CADVISOR=192m
# LLM layer (prompt 03). claude-runtime: ~180 MB per idle CLI process,
# ~250-300 MB while answering, x RUNTIME_MAX_CONCURRENCY, + the service.
MEM_LLM_ROUTER=256m
MEM_CLAUDE_RUNTIME=1152m
LLM_MAX_CONCURRENCY=3
RUNTIME_MAX_CONCURRENCY=3
# One-shot jobs (exit after running)
MEM_DB_PROVISION=64m
MEM_LLM_MIGRATE=192m
MEM_HQ_TOOLS=16m
MEM_TEMPORAL_SCHEMA=128m
MEM_TEMPORAL_NAMESPACE=64m

# Go runtime soft limits (~80% of the container limit)
GOMEMLIMIT_NATS=200MiB
GOMEMLIMIT_TEMPORAL=512MiB
GOMEMLIMIT_LOKI=300MiB
GOMEMLIMIT_ALLOY=150MiB

# PostgreSQL
PG_MAX_CONNECTIONS=120
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=640MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_WORK_MEM=4MB

# Valkey (cache; must sit below MEM_VALKEY)
VALKEY_MAXMEMORY=256mb

# Retention
PROM_RETENTION_TIME=15d
PROM_RETENTION_SIZE=4GB
LOKI_RETENTION_PERIOD=336h
