# CoinePro HQ — variable names only. Real values live in infra/compose/.env
# (mode 600, gitignored). Create it with `make env`, which fills every
# *_PASSWORD with a strong random value and never prints them.

# --- Profile -----------------------------------------------------------------
# Empty = automatic from server RAM (MemTotal < 15 GiB, i.e. below a nominal
# 16 GB server, -> lean; otherwise full). Set to lean or full to force one.
HQ_PROFILE=

# --- Edge (Caddy) ------------------------------------------------------------
# Empty = plain HTTP on :80. Set to the domain (e.g. hq.example.com) to switch
# on automatic HTTPS. That single line is the whole change.
HQ_SITE_ADDRESS=

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_PASSWORD=
HQ_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
TEMPORAL_VISIBILITY_DB_PASSWORD=
# llm-router's database login (role llm_router, member of hq_llm_writer)
LLM_ROUTER_DB_PASSWORD=
# apps/api logins (prompt 04): roles hq_api (api) and hq_worker (worker)
HQ_API_DB_PASSWORD=
HQ_WORKER_DB_PASSWORD=

# --- Valkey ------------------------------------------------------------------
VALKEY_PASSWORD=

# --- NATS --------------------------------------------------------------------
NATS_PASSWORD=

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=

# --- SearXNG (prompt 07 §2): its server.secret_key (internal only) ------------
SEARXNG_PASSWORD=

# --- Backups: offsite copy to Hetzner Object Storage (off until the owner
# --- provides a bucket) -------------------------------------------------------
HQ_BACKUP_S3_ENABLED=
HQ_BACKUP_S3_ENDPOINT=
HQ_BACKUP_S3_REGION=
HQ_BACKUP_S3_BUCKET=
HQ_BACKUP_S3_PREFIX=
HQ_BACKUP_S3_ACCESS_KEY_ID=
HQ_BACKUP_S3_SECRET_ACCESS_KEY=

# --- Agent runtime (prompt 05) ---------------------------------------------
# Real-model spend of all agent runs per UTC day: input + output + cache
# (read and write) tokens. A run stops before its next model call once the
# day's total reaches it. Empty = 2000000; the owner's cap (2026-10-17): 600000.
# WARNING: 0 means NO cap at all (unlimited real-model spend).
AGENT_DAILY_TOKEN_CAP=
# The oversight share (prompt 08 §2.3): the Chief Overseer and QC together use at
# most this fraction of AGENT_DAILY_TOKEN_CAP per UTC day (llm-router enforces
# it; once spent only critical protocols run, the rest are deferred). 0..1;
# empty = 0.2.
OVERSIGHT_DAILY_SHARE=
# The owner zone's share (prompt 12 §15, contract §21.0): the automatic runs of
# the advisor (automatic memos, proactive notes, the weekly brief), the
# librarian and the digital CEO together use at most this fraction of
# AGENT_DAILY_TOKEN_CAP per UTC day (llm-router enforces it); the owner's own
# requests always run. 0..1; empty = 0.25 (the owner's decision is pending).
OWNER_ZONE_DAILY_SHARE=
# A new connection's secret (prompt 12 §9): `api` = the app's write-only route
# (POST /connections/{id}/secret) and the terminal both work (the default, the
# owner's decision is pending); `terminal` = only `make connection-secret`.
CONNECTION_SECRET_ROUTE=
# The CEOs' daily report runs: off until the owner switches them on.
HQ_CEO_DAILY_REPORTS=
# The morning report rewritten as fluent Persian by Sonnet 5.5 (no new numbers).
HQ_MORNING_REPORT_LLM=
# Android app (web panel's /.well-known/assetlinks.json); empty = the web's defaults
# Passkey origin of the Android app: android:apk-key-hash:<base64url SHA-256 of
# its signing certificate>, comma separated (public, prompt 6 §1.2).
HQ_ANDROID_ORIGINS=
HQ_ANDROID_PACKAGES=
HQ_ANDROID_CERT_SHA256=

# --- Revenue and support (prompt 10, contract §19) --------------------------
# Empty = the default in brackets. No agent, schedule or pull of prompt 10 calls
# a model or an outside service while the holding kill switch is engaged.
# Conversation texts older than this many days are purged daily; rows, times,
# states and tags stay (owner default §0.1 #4) [180].
SUPPORT_RETENTION_DAYS=
# Tokens of model drafts per company per UTC day; once spent, that day's other
# messages are handed to the owner without a model call [60000].
SUPPORT_DRAFT_DAILY_TOKENS=
# Automatic outbound messages per company per day (429 send_limit) [300], and
# automatic replies per conversation per hour (the loop guard) [20].
SUPPORT_DAILY_OUTBOUND_CAP=
SUPPORT_AUTO_REPLIES_PER_HOUR=
# The owner's digest line for handoffs, batched every N minutes [30].
SUPPORT_HANDOFF_DIGEST_MIN=
# referral.check per company per hour [30], and its cache in seconds [600].
REFERRAL_CHECKS_PER_HOUR=
REFERRAL_CHECK_CACHE_S=
# The revenue radar: the first pull's backfill [90] and a manual pull's range [31] (days).
REVENUE_BACKFILL_DAYS=
REVENUE_PULL_MAX_DAYS=
# Signed intake (Chatwoot, products): accepted timestamp skew in seconds [300].
INTAKE_MAX_SKEW_S=

# The provisioner (prompt 09 §4): on once the owner has stored the Hetzner
# token (make hetzner-token) and a public SSH key (make owner-ssh-key).
HQ_PROVISIONING=

# Opt-in profile "tracing" (Tempo + otel-collector; review 7.1 §0.2): on|off,
# empty = off. Use make tracing-on / make tracing-off.
HQ_TRACING=

# Opt-in profile "mcp" (prompt 12 §14: the MCP servers in containers on
# hq-mcp, infra/compose/mcp.yaml): on|off, empty = off. Refused while it does
# not fit the memory budget; switching it on is the owner's decision.
HQ_MCP=
# The substitute players (prompt 12 §9.1): the CLI runner (profile
# "substitutes") and the signed-in browser profiles (profile
# "substitutes-web"): on|off, empty = off. Both stay off until the owner has
# signed in (make chatgpt-login, make gemini-login, make <x>-web-login) and the
# memory budget allows them (hq.sh refuses them otherwise); the choice between
# STT, TTS, container MCP and these is the owner's.
HQ_SUBSTITUTES=
HQ_SUBSTITUTES_WEB=
# Opt-in profile "tts" (the Persian voice of the briefings, prompt 12 §4):
# on|off, empty = off. Use make tts-on / make tts-off. The voice: a free one
# (fa_IR-amir-medium, CC0 dataset) unless the owner picks another.
HQ_TTS=
HQ_TTS_VOICE=fa_IR-amir-medium
