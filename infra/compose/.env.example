# CoinePro HQ — variable names only. Real values live in infra/compose/.env
# (mode 600, gitignored). Create it with `make env`, which fills every
# *_PASSWORD with a strong random value and never prints them.

# --- Profile -----------------------------------------------------------------
# Empty = automatic from server RAM (MemTotal < 15 GiB, i.e. below a nominal
# 16 GB server, -> lean; otherwise full). Set to lean or full to force one.
HQ_PROFILE=

# --- Edge (Caddy) ------------------------------------------------------------
# Empty = plain HTTP on :80. Set to the domain (e.g. hq.example.com) to switch
# on automatic HTTPS. That single line is the whole change.
HQ_SITE_ADDRESS=

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_PASSWORD=
HQ_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
TEMPORAL_VISIBILITY_DB_PASSWORD=
# llm-router's database login (role llm_router, member of hq_llm_writer)
LLM_ROUTER_DB_PASSWORD=
# apps/api logins (prompt 04): roles hq_api (api) and hq_worker (worker)
HQ_API_DB_PASSWORD=
HQ_WORKER_DB_PASSWORD=

# --- Valkey ------------------------------------------------------------------
VALKEY_PASSWORD=

# --- NATS --------------------------------------------------------------------
NATS_PASSWORD=

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=

# --- Backups: offsite copy to Hetzner Object Storage (off until the owner
# --- provides a bucket) -------------------------------------------------------
HQ_BACKUP_S3_ENABLED=
HQ_BACKUP_S3_ENDPOINT=
HQ_BACKUP_S3_REGION=
HQ_BACKUP_S3_BUCKET=
HQ_BACKUP_S3_PREFIX=
HQ_BACKUP_S3_ACCESS_KEY_ID=
HQ_BACKUP_S3_SECRET_ACCESS_KEY=

# --- Agent runtime (prompt 05) ---------------------------------------------
# Real-model spend of all agent runs per UTC day: input + output + cache
# (read and write) tokens. A run stops before its next model call once the
# day's total reaches it. Empty = 2000000; the owner's cap (2026-10-17): 600000.
# WARNING: 0 means NO cap at all (unlimited real-model spend).
AGENT_DAILY_TOKEN_CAP=
# The CEOs' daily report runs: off until the owner switches them on.
HQ_CEO_DAILY_REPORTS=
# The morning report rewritten as fluent Persian by Sonnet 5.5 (no new numbers).
HQ_MORNING_REPORT_LLM=
# Android app (web panel's /.well-known/assetlinks.json); empty = the web's defaults
# Passkey origin of the Android app: android:apk-key-hash:<base64url SHA-256 of
# its signing certificate>, comma separated (public, prompt 6 §1.2).
HQ_ANDROID_ORIGINS=
HQ_ANDROID_PACKAGES=
HQ_ANDROID_CERT_SHA256=
