[Unit]
Description=CoinePro HQ: hourly encrypted backup (restic: local, Google Drive, optional Hetzner)
Requires=docker.service
After=docker.service

[Service]
# 2026-11-20: 3 daily WAL-G base backups on the disk (local PITR over ~2 days, ~4G instead of ~12G);
# older points in time are in the restic snapshots on Drive (hourly 168, daily 90, weekly 52, monthly 36).
Environment=HQ_WAL_KEEP_FULL=3
Type=oneshot
User=Hub
Group=Hub
ExecStart=/home/Hub/CoinePro-Hub/infra/backup/hourly.sh
TimeoutStartSec=50min
Nice=10
IOSchedulingClass=idle
# The run's secrets live here only (tmpfs under /run, 0700, Hub's); systemd
# removes the directory when the run ends, however it ends (7.1 §3).
RuntimeDirectory=coinepro-hq-backup-hourly
RuntimeDirectoryMode=0700
