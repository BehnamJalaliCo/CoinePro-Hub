[Unit]
Description=CoinePro HQ: weekly restore test (newest snapshot, every check, PITR to a random moment)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=Hub
Group=Hub
ExecStart=/home/Hub/CoinePro-Hub/infra/backup/restore-weekly.sh
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
# The run's secrets live here only (tmpfs under /run, 0700, Hub's); systemd
# removes the directory when the run ends, however it ends (7.1 §3).
RuntimeDirectory=coinepro-hq-restore-weekly
RuntimeDirectoryMode=0700
