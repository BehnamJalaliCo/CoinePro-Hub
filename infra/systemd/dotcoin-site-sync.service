[Unit]
Description=DotCoin.me: the hub's daily lessons to the live site (content/auto, commit, push, deploy)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=Hub
Group=Hub
# the content worktree (branch site/dotcoin-content) runs its own copy of the script; state and lock in
# /home/Hub/sites. deploy.sh needs sudo -u studio (the OG cards), so no NoNewPrivileges here.
WorkingDirectory=/home/Hub/sites/dotcoin-content
ExecStart=/usr/bin/python3 -I /home/Hub/sites/dotcoin-content/automations/sites/dotcoin/sync.py
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
