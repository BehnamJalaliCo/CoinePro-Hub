[Unit]
Description=CoinePro HQ: one substitute player's job (ChatGPT or Gemini CLI), if the runner is on
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=Hub
Group=Hub
# Exits at once unless HQ_SUBSTITUTES=on (infra/compose/.env) and its api token
# exists; the api hands out no job while the holding's kill switch is engaged.
ExecStart=/home/Hub/CoinePro-Hub/infra/substitutes/dispatch.sh
TimeoutStartSec=35min
Nice=10
# A job's checkout and lock live here only (tmpfs under /run, 0700, Hub's,
# visible to dockerd for the read-only mount); removed when the run ends.
RuntimeDirectory=coinepro-hq-substitutes
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=full
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
