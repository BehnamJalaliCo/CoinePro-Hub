[Unit]
Description=CoinePro HQ: the media studio's render pass (claim, render with no network, send; prompt 13 §2.3)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=Hub
Group=Hub
# Does nothing unless HQ_MEDIA=on; waits on /run/hq/oneshot.lock (shared with
# the backups and the TTS pass) and renders at most MEDIA_MAX_JOBS jobs. The
# courier asks the api for work: 204 while the holding (or the job's company)
# is locked, so nothing is rendered then.
ExecStart=/home/Hub/CoinePro-Hub/infra/media/run-once.sh
TimeoutStartSec=40min
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
