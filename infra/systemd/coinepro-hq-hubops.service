[Unit]
Description=CoinePro HQ: one hub operation from the app (hub.ops, the services page), if its token exists
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=Hub
Group=Hub
# Exits at once without its api token (make hubops-token); the api hands out no
# job while the holding's kill switch is engaged. Runs only the fixed commands of
# its own allow-list (infra/hubops/dispatch.sh), never a shell from the hub.
ExecStart=/home/Hub/CoinePro-Hub/infra/hubops/dispatch.sh
# The longest job is the hourly backup or a profile's image build.
TimeoutStartSec=75min
Nice=5
# A job's files and the lock live here only (tmpfs under /run, 0700, Hub's);
# the snapshot's clock survives between runs in the state directory.
RuntimeDirectory=coinepro-hq-hubops
RuntimeDirectoryMode=0700
StateDirectory=coinepro-hq-hubops
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=full
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
