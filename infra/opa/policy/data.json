        "batch.max_items": {
          "field": "items",
          "min": 1,
          "max": 50,
          "default": 20
        }
      },
      "authority_lists": {
        "deploy.blackout_days": {
          "field": "days",
          "allowed": [
            "sat",
            "sun",
            "mon",
            "tue",
            "wed",
            "thu",
            "fri"
          ],
          "default": [
            "fri"
          ]
        },
        "batch.kinds": {
          "field": "kinds",
          "allowed": [
            "proposal",
            "meeting_resolution",
            "knowledge_entry"
          ],
          "default": [
            "proposal",
            "meeting_resolution",
            "knowledge_entry"
          ]
