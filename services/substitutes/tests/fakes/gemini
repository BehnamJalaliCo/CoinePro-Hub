#!/usr/bin/env python3
"""A fake Google Gemini CLI for the runner's tests (never the real one).

Mode (the file <tmp>/mode): ok | limited | signed_out | no_model | slow
<tmp>/rec: a directory where argv, stdin and the settings path are written.
Without -p it plays the interactive sign-in (NO_BROWSER): the URL, then the
authorization code read from its terminal."""

import json
import os
import sys
import time
from pathlib import Path

# The test's own directory: HOME is <tmp>/work/.home (the runner's fixed env).
base = Path(os.environ.get("HOME", "/tmp/x/.home")).parent.parent
mode_file = base / "mode"
mode = mode_file.read_text().strip() if mode_file.is_file() else "ok"
record = str(base / "rec") if (base / "rec").is_dir() else None
args = sys.argv[1:]
home = Path(os.environ.get("GEMINI_CLI_HOME", "/tmp/gemini")) / ".gemini"

if "-p" not in args:
    if not sys.stdin.isatty():
        print("Manual authorization is required but the current session is non-interactive.")
        sys.exit(41)
    print("Please visit the following URL to authorize the application:\n")
    print("https://accounts.google.com/o/oauth2/v2/auth?client_id=fake&state=s1\n")
    sys.stdout.write("Enter the authorization code: ")
    sys.stdout.flush()
    code = sys.stdin.readline().strip()
    if code != "GOOD-CODE-123":
        print("Failed to authenticate with authorization code: invalid_grant", flush=True)
        time.sleep(30)
        sys.exit(1)
    home.mkdir(parents=True, exist_ok=True)
    (home / "oauth_creds.json").write_text(json.dumps({"refresh_token": "fake"}))
    print("Authenticated.", flush=True)
    time.sleep(30)  # the TUI stays until it is closed
    sys.exit(0)

prompt = sys.stdin.read()
if record:
    Path(record, "gemini-argv.json").write_text(json.dumps(sys.argv))
    Path(record, "gemini-stdin.txt").write_text(prompt)
    Path(record, "gemini-settings.txt").write_text(os.environ.get("GEMINI_CLI_SYSTEM_SETTINGS_PATH", ""))
if mode == "slow":
    time.sleep(30)
if mode == "limited":
    print(json.dumps({"error": {"type": "Error", "message": "429 RESOURCE_EXHAUSTED: Quota exceeded. Please retry after 60 seconds.", "code": 429}}))
    sys.exit(1)
if mode == "signed_out":
    print(json.dumps({"error": {"type": "Error", "message": "Please set an Auth method in your settings", "code": 41}}))
    sys.exit(41)
if mode == "no_model":
    print(json.dumps({"error": {"type": "Error", "message": "Requested entity was not found. model not found", "code": 1}}))
    sys.exit(1)
print(json.dumps({
    "session_id": "s",
    "response": "پیش‌نویس آزمایشی",
    "stats": {"models": {"gemini-3.8": {"tokens": {"prompt": 200, "candidates": 50, "total": 250, "cached": 0, "thoughts": 10}}}},
}))
sys.exit(0)
