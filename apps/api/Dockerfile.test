# Test/lint image for apps/api: runtime + dev dependencies, hash-pinned.
# Source is mounted at /api (and services/ at /w for hq-common) at run time.
FROM python:3.12.15-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/w/hq-common/src:/api/src

# ffmpeg/ffprobe (LGPL/GPL, Debian trixie, exact version): posters, key frames
# and sound tracks of owner videos, and media durations (prompt 6 §2).
# git (prompt 12 §7): the deploy card's diff, tested on local bare repositories.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg=7:7.1.5-0+deb13u1 \
       git=1:2.47.3-0+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-test.lock /tmp/requirements-test.lock
RUN pip install --require-hashes --no-deps -r /tmp/requirements-test.lock \
    && useradd --uid 10001 --create-home tester

USER 10001
WORKDIR /api
